# Copy this file to .env and fill in your own values. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Local PostgreSQL (create the database first: createdb aidflow)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/aidflow

# Vite dev server address (comma-separate to allow several origins)
CORS_ORIGIN=http://localhost:5173

# Dispatch: how long a driver has to respond (server-enforced)
DISPATCH_TIMEOUT_MS=20000

# Needed from the login step onward (min 16 characters)
JWT_SECRET=change_me_to_a_long_random_string

# Password given to the demo users created by db:seed (demo data only)
SEED_DEMO_PASSWORD=ChangeMe123!

LOG_LEVEL=info
